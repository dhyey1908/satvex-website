# Server
PORT=4000
NODE_ENV=development

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# AWS
AWS_REGION=ap-south-1

# DynamoDB table names
TABLE_USERS=satvex_users
TABLE_PRODUCTS=satvex_products
TABLE_ORDERS=satvex_orders
TABLE_CARTS=satvex_carts
TABLE_WISHLISTS=satvex_wishlists
TABLE_CONTACTS=satvex_contacts
TABLE_SETTINGS=satvex_settings
TABLE_ADDRESSES=satvex_addresses
TABLE_COUPONS=satvex_coupons
TABLE_REVIEWS=satvex_reviews
TABLE_COUPON_REDEMPTIONS=satvex_coupon_redemptions
TABLE_SHIPMENT_JOBS=satvex_shipment_jobs
TABLE_OTP_CODES=satvex_otp_codes

# S3
S3_MEDIA_BUCKET=satvex-media
CLOUDFRONT_MEDIA_URL=https://media.example.cloudfront.net

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_MIN=30

# SES (password reset emails)
SES_SENDER_EMAIL=no-reply@example.com

# SNS (phone OTP for checkout verification + phone-based login/signup).
# IMPORTANT: SMS to Indian mobile numbers additionally requires DLT
# (Distributed Ledger Technology) registration with an Indian telecom DLT
# platform -- a Principal Entity ID + an approved message template -- per
# TRAI regulation. This is separate from AWS IAM permissions; without it,
# SNS.Publish succeeds at the API level but carriers silently reject the
# SMS. SNS_SENDER_ID is the DLT-approved alphanumeric sender ID once you
# have one; leave blank until then (SNS falls back to its default sender,
# which Indian carriers will typically still reject without DLT).
SNS_SENDER_ID=

# Admin bootstrap (used only by scripts/createAdmin.js, never commit real values)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

# Shiprocket shipping — real account, no sandbox/live split on Shiprocket's
# own side. Gated off by default via settings.shiprocket.enabled, so no real
# API calls happen until explicitly turned on in Admin Settings.
# API user email (Settings > API > Add New API User in the Shiprocket
# panel — must differ from the main panel login email), and its password.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Get from: same Settings > API page > Webhooks tab — you invent this
# string yourself, paste it in both places. Optional — leave blank to skip
# the webhook auth check entirely (fine for local testing, not production).
SHIPROCKET_WEBHOOK_TOKEN=
# Only used by `npm run shiprocket-sample-rate` (the one-off debug script,
# src/scripts/shiprocket-sample-rate.js) — not read anywhere in the deployed
# app. The real Rajkot pickup pincode goes in Admin Settings
# (settings.shiprocket.pickupPincode), not here.
SHIPROCKET_PICKUP_PINCODE=

# PayU (online checkout payment gateway). Get merchant key/salt from the
# PayU dashboard (test credentials for sandbox: https://test.payu.in/).
# PAYU_ENV=test uses PayU's test endpoints; set to production for go-live.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=test

# Optional override for this API's own public base URL (no trailing
# slash), used to build PayU's surl/furl callback. Normally leave this
# blank -- it's derived automatically from the incoming request's Host
# header, which works correctly both locally and once deployed. Only set
# this if something in front of the API (an unusual proxy/tunnel) rewrites
# the Host header to something PayU shouldn't actually POST back to.
API_BASE_URL=
