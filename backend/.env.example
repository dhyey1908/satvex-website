# Server
PORT=4000
NODE_ENV=development

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# AWS
AWS_REGION=ap-south-1

# DynamoDB table names
TABLE_USERS=satvex_users
TABLE_PRODUCTS=satvex_products
TABLE_ORDERS=satvex_orders
TABLE_CARTS=satvex_carts
TABLE_WISHLISTS=satvex_wishlists
TABLE_CONTACTS=satvex_contacts
TABLE_SETTINGS=satvex_settings
TABLE_ADDRESSES=satvex_addresses
TABLE_COUPONS=satvex_coupons
TABLE_REVIEWS=satvex_reviews
TABLE_COUPON_REDEMPTIONS=satvex_coupon_redemptions
TABLE_SHIPMENT_JOBS=satvex_shipment_jobs

# S3
S3_MEDIA_BUCKET=satvex-media
CLOUDFRONT_MEDIA_URL=https://media.example.cloudfront.net

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_MIN=30

# SES (password reset emails)
SES_SENDER_EMAIL=no-reply@example.com

# Admin bootstrap (used only by scripts/createAdmin.js, never commit real values)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

# Shiprocket shipping — real account, no sandbox/live split on Shiprocket's
# own side. Gated off by default via settings.shiprocket.enabled, so no real
# API calls happen until explicitly turned on in Admin Settings.
# API user email (Settings > API > Add New API User in the Shiprocket
# panel — must differ from the main panel login email), and its password.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Get from: same Settings > API page > Webhooks tab — you invent this
# string yourself, paste it in both places. Optional — leave blank to skip
# the webhook auth check entirely (fine for local testing, not production).
SHIPROCKET_WEBHOOK_TOKEN=
# Only used by `npm run shiprocket-sample-rate` (the one-off debug script,
# src/scripts/shiprocket-sample-rate.js) — not read anywhere in the deployed
# app. The real Rajkot pickup pincode goes in Admin Settings
# (settings.shiprocket.pickupPincode), not here.
SHIPROCKET_PICKUP_PINCODE=
