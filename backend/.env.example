# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated if you need both local + a deployed origin, e.g.
# "http://localhost:5173,https://your-cloudfront-domain.net"
FRONTEND_ORIGIN=http://localhost:5173

# AWS — credentials themselves come from `aws configure` / your AWS CLI
# profile, never from this file. This is just the region your tables/buckets
# live in.
AWS_REGION=ap-south-1

# DynamoDB table names — match whatever you deployed (see template.yaml;
# SAM appends _${Stage}, e.g. satvex_orders_dev). Create these tables
# yourself for pure local dev, or point at your deployed dev stack's names.
TABLE_USERS=satvex_users
TABLE_PRODUCTS=satvex_products
TABLE_ORDERS=satvex_orders
TABLE_CARTS=satvex_carts
TABLE_WISHLISTS=satvex_wishlists
TABLE_CONTACTS=satvex_contacts
TABLE_SETTINGS=satvex_settings
TABLE_ADDRESSES=satvex_addresses
TABLE_COUPONS=satvex_coupons
TABLE_REVIEWS=satvex_reviews
TABLE_COUPON_REDEMPTIONS=satvex_coupon_redemptions
TABLE_SHIPMENT_JOBS=satvex_shipment_jobs

# S3 — your media bucket + the CloudFront domain in front of it (see
# template.yaml's MediaBucket/MediaDistribution).
S3_MEDIA_BUCKET=satvex-media
CLOUDFRONT_MEDIA_URL=https://media.example.cloudfront.net

# Auth — JWT_SECRET is not fetched from anywhere, you generate it yourself:
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# Use a different one per environment; never reuse the prod secret locally.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_MIN=30

# SES (password reset emails) — must be a verified sender identity in AWS
# SES console (Simple Email Service > Verified identities > Create identity).
# While SES is in sandbox mode, every recipient must ALSO be a verified
# identity, or sends silently fail.
SES_SENDER_EMAIL=no-reply@example.com

# Admin bootstrap (used only by scripts/createAdmin.js, never commit real
# values) — these aren't fetched from anywhere, you choose them yourself;
# the script creates one admin user with this email/password on first run.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Cashfree — existing, real payment gateway (unaffected by GoKwik/Shiprocket)
# ---------------------------------------------------------------------------
# Get from: https://merchant.cashfree.com -> Developers -> API Keys.
# Toggle the "Test Mode" switch there to get sandbox keys (CASHFREE_ENV=
# sandbox) vs. production keys (CASHFREE_ENV=production). Sandbox and
# production each have their own separate App ID/Secret Key pair.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# ---------------------------------------------------------------------------
# GoKwik checkout — SANDBOX ONLY, gated off by default (see
# settings.payments.gokwikEnabled/gokwikTestUserIds). See
# gokwik_integration_notes.md for the full API reference.
# ---------------------------------------------------------------------------
# Get from: https://dashboard.gokwik.co (GoKwik merchant dashboard) ->
# Settings/Developer section -> API Credentials. You need a GoKwik sandbox
# account provisioned for this store by GoKwik's onboarding team before this
# page shows anything — ask your GoKwik point of contact for sandbox access
# if the dashboard is empty. appid/appsecret are shown there as plain text
# (regenerate them from the same page if you need new ones).
GOKWIK_APP_ID=
GOKWIK_APP_SECRET=
# 'sandbox' | 'production' — which GoKwik base URL requests go to. Stay on
# sandbox until GoKwik support confirms the open questions in
# gokwik_integration_notes.md.
GOKWIK_ENV=sandbox
# 'mock' | 'live'.
#   mock -> every GoKwik call is simulated by src/services/mockGokwikService.js,
#           zero network calls, works with NO credentials above. Use this for
#           local dev and automated tests.
#   live -> calls the real GoKwik sandbox API using GOKWIK_APP_ID/APP_SECRET
#           above. Use this to test against GoKwik's actual sandbox.
GOKWIK_MODE=mock

# ---------------------------------------------------------------------------
# Shiprocket shipping — real account, no separate sandbox/live split on
# Shiprocket's own side (gated off by default via settings.shiprocket.
# enabled). See shiprocket_integration_notes.md for the full API reference.
# ---------------------------------------------------------------------------
# Get from: https://app.shiprocket.in -> log in with the MAIN panel account
# -> Settings -> API -> "Add New API User". Create a dedicated API user
# there (its email must be DIFFERENT from your main panel login email) —
# SHIPROCKET_EMAIL/PASSWORD below are that API user's login, not your main
# Shiprocket account login. Needs an active Shiprocket account (any plan);
# there is no free/test account Shiprocket issues separately for this.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Get from: same Settings -> API page -> Webhooks tab -> set your own
# "security token" string there (you invent this value, then paste the same
# string here and in Shiprocket's panel). Optional — leave blank to skip the
# webhook auth check entirely (fine for local testing, not for production).
SHIPROCKET_WEBHOOK_TOKEN=
# 'mock' | 'live'.
#   mock -> every Shiprocket call is simulated by
#           src/services/mockShiprocketService.js, zero network calls, works
#           with NO credentials above. Use this for local dev and automated
#           tests — never creates a real shipment.
#   live -> calls the real Shiprocket API using SHIPROCKET_EMAIL/PASSWORD
#           above. Only use this once settings.shiprocket.enabled is also
#           turned on in Admin Settings AND pickupLocation is set to a real
#           pickup address nickname already created in the Shiprocket panel
#           (Settings -> Pickup Addresses) — otherwise every call fails.
SHIPROCKET_MODE=mock
