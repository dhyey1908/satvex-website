# Copy to samconfig.toml and fill in the REPLACE_ME values. samconfig.toml is
# gitignored since it holds account/region-specific deployment state.
# Once filled in, `npm run deploy` (= `sam build && sam deploy`) needs no flags.
version = 0.1

[default.deploy.parameters]
stack_name = "satvex-backend-prod"
resolve_s3 = true
region = "ap-south-1"
profile = "REPLACE_ME"
confirm_changeset = false
fail_on_empty_changeset = false
capabilities = "CAPABILITY_IAM"
parameter_overrides = "Stage=prod FrontendOrigin=https://your-domain.com JwtSecret=REPLACE_ME SesSenderEmail=REPLACE_ME ResetTokenExpiresMin=30"
