# Copy to samconfig.toml and fill in the REPLACE_ME values. samconfig.toml is
# gitignored since it holds account/region-specific deployment state.
# Once filled in, `npm run deploy` (= `sam build && sam deploy`) needs no flags.
version = 0.1

[dev.deploy.parameters]
stack_name = "satvex-backend-dev"
resolve_s3 = true
region = "ap-south-1"
profile = "REPLACE_ME"                # your AWS CLI profile name
confirm_changeset = false
fail_on_empty_changeset = false
capabilities = "CAPABILITY_IAM"
# Comma-separated: every origin that will call this API (local dev + the
# CloudFront domain once you have it from a first deploy's outputs).
parameter_overrides = "Stage=dev FrontendOrigin=\"http://localhost:5173,https://REPLACE_ME.cloudfront.net\" JwtSecret=REPLACE_ME SesSenderEmail=REPLACE_ME ResetTokenExpiresMin=30"

[default.deploy.parameters]
stack_name = "satvex-backend-prod"
resolve_s3 = true
region = "ap-south-1"
profile = "REPLACE_ME"
confirm_changeset = false
fail_on_empty_changeset = false
capabilities = "CAPABILITY_IAM"
parameter_overrides = "Stage=prod FrontendOrigin=https://your-domain.com JwtSecret=REPLACE_ME SesSenderEmail=REPLACE_ME ResetTokenExpiresMin=30"
